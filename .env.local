# Database - use localhost when running uvicorn directly on the host
DATABASE_URL=postgresql+asyncpg://auth_user:auth_pass@localhost:5433/auth_db

# Redis - use localhost when running uvicorn directly on the host
REDIS_URL=redis://:redispass@localhost:6380/0
REDIS_PASSWORD=redispass

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_COOKIE_MAX_AGE_SECONDS=3600

# CORS
CORS_ORIGINS='["http://localhost:3000"]'

# Security
BCRYPT_ROUNDS=12

# Trusted Proxy IPs for rate-limiting (comma-separated IPs or CIDR ranges).
TRUSTED_PROXY_IPS=10.0.0.1
