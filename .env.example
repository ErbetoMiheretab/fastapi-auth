# Database
DATABASE_URL=postgresql+asyncpg://auth_user:auth_pass@auth-db:5432/auth_db

# Redis
REDIS_URL=redis://:redispass@auth-redis:6379/0
REDIS_PASSWORD=redispass

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_COOKIE_MAX_AGE_SECONDS=3600


# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Security
BCRYPT_ROUNDS=12

# Trusted Proxy IPs for rate-limiting (comma-separated IPs or CIDR ranges).
# Set to the IP(s) of your nginx / load-balancer so that X-Forwarded-For is
# only trusted from known proxies.  Leave empty to always use direct IP.
# Example: TRUSTED_PROXY_IPS=10.0.0.1,172.16.0.0/12
TRUSTED_PROXY_IPS=